# Solana RPC WebSocket URL (mainnet)
# Public: wss://api.mainnet-beta.solana.com
# QuikNode/Helius/etc. recommended for production
WS_RPC_URL=wss://api.mainnet-beta.solana.com

# Solana RPC HTTP URL
HTTP_RPC_URL=https://api.mainnet-beta.solana.com

# Target wallet address to copy-trade
WALLET_ADDRESS=YOUR_TARGET_WALLET_ADDRESS

# Your wallet private key (base58 encoded)
# WARNING: Never commit this value!
PRIVATE_KEY_STRING=YOUR_PRIVATE_KEY_BASE58

# Destination address for transfers (optional)
DESTINATION_ADDRESS=YOUR_DESTINATION_ADDRESS

# Transaction commitment level: processed | confirmed | finalized
TRANSACTION_STATUS=confirmed
